# Copy to .env for local use. Do not commit .env.
# On Vercel, set these in Project Settings, Environment Variables.

# Live Wix site. Leave blank when using sample data.
WIX_API_KEY=
WIX_SITE_ID=

# Optional. If blank, the server picks a plan priced 2.50 GBP, or one whose name contains "lottery".
WIX_LOTTERY_PLAN_ID=

# Set to 1 to use obviously fake sample members and skip Wix.
WIX_MOCK=

# Required to view member status. Draw Winner is only the manual fallback.
ADMIN_PASSWORD=

# Required for the scheduled draw. Vercel sends Authorization: Bearer $CRON_SECRET.
# The draw runs at 20:00 UK time on the 1st. Cron checks 19:00, 20:00, 21:00, and 22:00 UTC.
CRON_SECRET=

# Optional. Stable secret for public entry references. If empty, ADMIN_PASSWORD is used.
# Do not change this after the first draw, or published references will change.
ENTRY_REF_SECRET=
