{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/((?!winners-embed).*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/winners-embed",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://www.alconbury-weald.org https://alconbury-weald.org https://*.wix.com https://*.wixsite.com https://*.filesusr.com https://*.wixstatic.com"
        }
      ]
    },
    {
      "source": "/winners-embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://www.alconbury-weald.org https://alconbury-weald.org https://*.wix.com https://*.wixsite.com https://*.filesusr.com https://*.wixstatic.com"
        }
      ]
    }
  ],
  "crons": [
    { "path": "/api/cron/draw", "schedule": "0 19 1 * *" },
    { "path": "/api/cron/draw", "schedule": "0 20 1 * *" },
    { "path": "/api/cron/draw", "schedule": "0 21 1 * *" },
    { "path": "/api/cron/draw", "schedule": "0 22 1 * *" }
  ]
}
