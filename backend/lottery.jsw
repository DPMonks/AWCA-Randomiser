import { ok } from 'wix-http-functions';
import wixData from 'wix-data';

export function post_lottery(request) {
  return request.body.json()
    .then(body => {
      const { subscriber, eventType, date } = body;
      return wixData.insert("LotterySubscribers", {
        name: subscriber.name,
        email: subscriber.email,
        plan: subscriber.plan,
        eventType,
        date
      }).then(() => ok({ status: "stored" }));
    });
}
